{
  "name": "gardens-v1-deprecation",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, reproducible verification tooling for the Gardens v1 deprecation proposal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run verify:safety",
    "verify:safety": "node scripts/verify-safety.mjs",
    "verify:design": "tsx src/cli.ts design",
    "export:bundle": "tsx src/cli.ts export",
    "verify:bundle": "tsx src/cli.ts verify",
    "verify:fork": "tsx src/cli.ts fork"
  },
  "dependencies": {
    "viem": "2.53.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "viem": {
      "ws": "8.21.0"
    }
  }
}
